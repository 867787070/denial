#!/usr/bin/env bash
# Assemble ARM64 .deb packages from artifacts this repository's own build steps
# produced on an ARM64 host.
#
# The upstream native packaging chain (tools/stage-denial-runtime,
# tools/package-denial-deb) hardcodes prebuilt/flutter-engine/linux-x64-release
# and gates on that directory's committed engine SHA-256, so it cannot stage an
# ARM64 engine. This script mirrors the upstream payload layout but sources the
# engine, compositor binaries and Flutter bundles from the ARM64 build outputs.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE_ROOT="${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}"
BUILD_ROOT="${DENIAL_PC_BUILD_ROOT:-$CACHE_ROOT/denial/pc-build}"
PACKAGE_ROOT="${DENIAL_PC_PACKAGE_ROOT:-$BUILD_ROOT/packages}"
RUST_OUT="$BUILD_ROOT/rust/release"
ENGINE_ROOT="$ROOT/prebuilt/flutter-engine/${DENIAL_FLUTTER_PLATFORM:?}-release"
SHELL_BUNDLE="$ROOT/dart_shell/build/linux/${DENIAL_FLUTTER_ARCH:?}/release/bundle"
SETTINGS_BUNDLE="$ROOT/settings_app/build/linux/${DENIAL_FLUTTER_ARCH:?}/release/bundle"
VERSION="${DEB_VERSION:-0.0.0}"
RELEASE="${DEB_RELEASE:-1}"
PACKAGER="${DENIAL_PACKAGE_PACKAGER:-Doctor Logix <doctor.logix@gmail.com>}"

fail() {
  printf 'build-arm64-deb: %s\n' "$1" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

for cmd in dpkg-deb install objdump readelf sha256sum; do
  require "$cmd"
done

for path in \
  "$RUST_OUT/deniald" \
  "$RUST_OUT/denialctl" \
  "$RUST_OUT/denial-portal" \
  "$ENGINE_ROOT/libflutter_engine.so" \
  "$SHELL_BUNDLE/data/icudtl.dat" \
  "$SHELL_BUNDLE/data/flutter_assets/AssetManifest.bin" \
  "$SHELL_BUNDLE/lib/libapp.so" \
  "$SETTINGS_BUNDLE/denial-settings" \
  "$SETTINGS_BUNDLE/data/flutter_assets/AssetManifest.bin" \
  "$SETTINGS_BUNDLE/lib/libapp.so" \
  "$SETTINGS_BUNDLE/lib/libflutter_linux_gtk.so"; do
  [[ -e "$path" ]] || fail "missing ARM64 build output: $path"
done

# Reject anything not actually built for ARM64 before it reaches a package.
for elf in \
  "$RUST_OUT/deniald" \
  "$RUST_OUT/denialctl" \
  "$RUST_OUT/denial-portal" \
  "$ENGINE_ROOT/libflutter_engine.so" \
  "$SHELL_BUNDLE/lib/libapp.so" \
  "$SETTINGS_BUNDLE/denial-settings" \
  "$SETTINGS_BUNDLE/lib/libapp.so" \
  "$SETTINGS_BUNDLE/lib/libflutter_linux_gtk.so"; do
  readelf -h "$elf" | grep -q 'Machine: *AArch64' \
    || fail "not an AArch64 ELF: $elf"
done

# Upstream keeps a hard 2.39 glibc ceiling so the payload stays installable on
# the declared Debian 12 / Ubuntu 24.04 baseline.
glibc_requirement() {
  objdump -T "$1" 2>/dev/null \
    | sed -n 's/.*(GLIBC_\([^)]*\)).*/\1/p' \
    | sort -Vu \
    | tail -n 1
}
for elf in \
  "$RUST_OUT/deniald" \
  "$RUST_OUT/denialctl" \
  "$RUST_OUT/denial-portal" \
  "$ENGINE_ROOT/libflutter_engine.so" \
  "$SHELL_BUNDLE/lib/libapp.so" \
  "$SETTINGS_BUNDLE/denial-settings" \
  "$SETTINGS_BUNDLE/lib/libapp.so" \
  "$SETTINGS_BUNDLE/lib/libflutter_linux_gtk.so"; do
  requirement="$(glibc_requirement "$elf")"
  [[ -z "$requirement" ]] && continue
  if [[ "$(printf '%s\n%s\n' 2.39 "$requirement" | sort -V | tail -n 1)" != 2.39 ]]; then
    fail "${elf##*/} requires GLIBC_$requirement, newer than the GLIBC_2.39 baseline"
  fi
done

install -d -m 0755 -- "$PACKAGE_ROOT"
work="$(mktemp -d)"
trap 'rm -rf --one-file-system -- "$work"' EXIT

engine_root="$work/denial-flutter-engine"
denial_root="$work/denial"
install -d -m 0755 -- "$engine_root" "$denial_root"

engine_sha256="$(sha256sum "$ENGINE_ROOT/libflutter_engine.so" | cut -d' ' -f1)"

# denial-flutter-engine
install -Dm755 "$ENGINE_ROOT/libflutter_engine.so" \
  "$engine_root/usr/lib/denial/flutter/lib/libflutter_engine.so"
install -Dm644 "$SHELL_BUNDLE/data/icudtl.dat" \
  "$engine_root/usr/lib/denial/flutter/data/icudtl.dat"
install -Dm644 "$ROOT/packaging/arch/flutter-engine/manifest.json" \
  "$engine_root/usr/share/denial/flutter-engine/manifest.json"
install -Dm644 "$ROOT/prebuilt/flutter-engine/SOURCE_LOCK.json" \
  "$engine_root/usr/share/denial/flutter-engine/SOURCE_LOCK.json"
printf '%s  libflutter_engine.so\n' "$engine_sha256" \
  >"$work/engine.sha256"
install -Dm644 "$work/engine.sha256" \
  "$engine_root/usr/share/denial/flutter-engine/libflutter_engine.so.sha256"
install -Dm644 "$ROOT/prebuilt/flutter-engine/linux-x64-release/ENGINE_REVISION" \
  "$engine_root/usr/share/denial/flutter-engine/ENGINE_REVISION"
install -Dm644 "$ROOT/prebuilt/flutter-engine/linux-x64-release/FLUTTER_REVISION" \
  "$engine_root/usr/share/denial/flutter-engine/FLUTTER_REVISION"
install -Dm644 "$ROOT/prebuilt/flutter-engine/linux-x64-release/LICENSE.flutter" \
  "$engine_root/usr/share/licenses/denial-flutter-engine/LICENSE.flutter"
install -Dm644 "$ROOT/prebuilt/flutter-engine/linux-x64-release/LICENSE.third_party" \
  "$engine_root/usr/share/licenses/denial-flutter-engine/LICENSE.third_party"

# denial
install -Dm755 "$RUST_OUT/deniald" "$denial_root/usr/bin/deniald"
install -Dm755 "$RUST_OUT/denialctl" "$denial_root/usr/bin/denialctl"
install -Dm755 "$RUST_OUT/denial-portal" "$denial_root/usr/bin/denial-portal"
install -Dm755 "$ROOT/packaging/arch/denial-session" \
  "$denial_root/usr/bin/denial-session"
install -Dm644 "$ROOT/packaging/denial-session.target" \
  "$denial_root/usr/lib/systemd/user/denial-session.target"
install -Dm644 "$ROOT/packaging/arch/denial-portal.service" \
  "$denial_root/usr/lib/systemd/user/denial-portal.service"
sh -n "$ROOT/packaging/denial-suspend-mode"
install -Dm755 "$ROOT/packaging/denial-suspend-mode" \
  "$denial_root/usr/lib/systemd/system-sleep/denial-suspend-mode"
install -Dm755 "$ROOT/packaging/denial-suspend-mode" \
  "$denial_root/usr/lib/elogind/system-sleep/denial-suspend-mode"

install -d -m 0755 "$denial_root/usr/lib/denial/flutter/data"
cp -a -- "$SHELL_BUNDLE/data/flutter_assets" \
  "$denial_root/usr/lib/denial/flutter/data/flutter_assets"
chmod -R u=rwX,go=rX "$denial_root/usr/lib/denial/flutter/data/flutter_assets"
install -Dm755 "$SHELL_BUNDLE/lib/libapp.so" \
  "$denial_root/usr/lib/denial/flutter/lib/libapp.so"
install -d -m 0755 "$denial_root/usr/lib/denial/settings"
cp -a -- "$SETTINGS_BUNDLE/." "$denial_root/usr/lib/denial/settings/"
chmod -R u=rwX,go=rX "$denial_root/usr/lib/denial/settings"
ln -s ../lib/denial/settings/denial-settings "$denial_root/usr/bin/denial-settings"

install -Dm644 "$ROOT/packaging/arch/denial.desktop" \
  "$denial_root/usr/share/wayland-sessions/denial.desktop"
install -Dm644 "$ROOT/packaging/arch/dev.denial.Settings.desktop" \
  "$denial_root/usr/share/applications/dev.denial.Settings.desktop"
install -Dm644 "$ROOT/packaging/arch/denial-portals.conf" \
  "$denial_root/usr/share/xdg-desktop-portal/denial-portals.conf"
install -Dm644 "$ROOT/packaging/arch/denial.portal" \
  "$denial_root/usr/share/xdg-desktop-portal/portals/denial.portal"
install -Dm644 "$ROOT/packaging/arch/org.freedesktop.impl.portal.desktop.denial.service" \
  "$denial_root/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.denial.service"
install -Dm644 "$ROOT/packaging/arch/xdg-desktop-portal-wlr-Denial" \
  "$denial_root/etc/xdg/xdg-desktop-portal-wlr/Denial"
install -Dm644 "$ROOT/packaging/arch/outputs.conf" \
  "$denial_root/etc/denial/outputs.conf"
install -Dm644 "$ROOT/packaging/arch/session.conf" \
  "$denial_root/etc/denial/session.conf"

install -Dm644 "$ROOT/README.md" "$denial_root/usr/share/doc/denial/README.md"
install -Dm644 "$ROOT/dart_shell/assets/wallpapers/ATTRIBUTION.md" \
  "$denial_root/usr/share/doc/denial/WALLPAPERS.md"
install -Dm644 "$ROOT/dart_shell/assets/cursors/BIBATA_MODERN_ICE.md" \
  "$denial_root/usr/share/doc/denial/CURSORS.md"
install -Dm644 "$ROOT/dart_shell/assets/cursors/bibata_modern_ice.sha256" \
  "$denial_root/usr/share/doc/denial/BIBATA_MODERN_ICE.sha256"
install -Dm644 "$ROOT/dart_shell/assets/fonts/README.md" \
  "$denial_root/usr/share/doc/denial/FONTS.md"
install -Dm644 "$ROOT/dart_shell/assets/fonts/JetBrainsMono.sha256" \
  "$denial_root/usr/share/doc/denial/JETBRAINS_MONO.sha256"
install -Dm644 "$ROOT/third_party/bibata/Bibata_Cursor-v2.0.7-source.tar.gz" \
  "$denial_root/usr/share/doc/denial/sources/Bibata_Cursor-v2.0.7-source.tar.gz"
install -Dm644 "$ROOT/LICENSES/CC-BY-SA-4.0.txt" \
  "$denial_root/usr/share/licenses/denial/CC-BY-SA-4.0.txt"
install -Dm644 "$ROOT/LICENSES/GPL-3.0-only.txt" \
  "$denial_root/usr/share/licenses/denial/GPL-3.0-only.txt"

install -d -m 0755 "$denial_root/usr/share/man/man1"
for manual in denialctl deniald denial-session denial-portal; do
  gzip -n -9 --stdout "$ROOT/docs/man/$manual.1" \
    >"$denial_root/usr/share/man/man1/$manual.1.gz"
  chmod 0644 "$denial_root/usr/share/man/man1/$manual.1.gz"
done

build_deb() {
  local name="$1" root="$2" control_body="$3"
  local out="$PACKAGE_ROOT/${name}_${VERSION}-${RELEASE}_arm64.deb"
  local installed_size
  install -d -m 0755 "$root/DEBIAN"
  installed_size="$(du -sk --apparent-size "$root" | cut -f1)"
  {
    printf 'Package: %s\n' "$name"
    printf 'Version: %s-%s\n' "$VERSION" "$RELEASE"
    printf 'Architecture: arm64\n'
    printf 'Maintainer: %s\n' "$PACKAGER"
    printf 'Installed-Size: %s\n' "$installed_size"
    printf '%s\n' "$control_body"
  } >"$root/DEBIAN/control"
  find "$root/DEBIAN" -print0 \
    | xargs -0 touch --no-dereference --date="@${SOURCE_DATE_EPOCH:-0}"
  dpkg-deb --root-owner-group --uniform-compression -Zxz \
    --build "$root" "$out"
  printf 'built %s\n' "$out"
}

install -d -m 0755 "$engine_root/usr/share/doc/denial-flutter-engine"
"$ROOT/tools/generate-denial-package-copyright" denial-flutter-engine \
  "$engine_root/usr/share/doc/denial-flutter-engine/copyright"

build_deb denial-flutter-engine "$engine_root" "\
Section: libs
Priority: optional
Depends: libc6 (>= 2.39), libfontconfig1
Provides: denial-flutter-engine-abi (= 3.44.7.denial1)
Conflicts: denial-flutter-engine-git
Homepage: https://github.com/denialwm/denial
Description: pinned Flutter Engine runtime for Denial
 Source-built Flutter Engine generation coupled to Denial's embedder ABI."

"$ROOT/tools/generate-denial-package-copyright" denial \
  "$denial_root/usr/share/doc/denial/copyright"

build_deb denial "$denial_root" "\
Section: x11
Priority: optional
Depends: bash, coreutils, dbus, denial-flutter-engine (= ${VERSION}-${RELEASE}), init-system-helpers (>= 1.66~), libc6 (>= 2.39), libegl1, libgbm1, libgcc-s1, libgl1, libgtk-3-0, libinput10, libpam0g, libpulse0, libseat1, libudev1, libxkbcommon0, rtkit, x11-xkb-utils, xkb-data, xserver-xorg-core, xwayland
Recommends: fonts-noto-cjk, network-manager, pipewire-pulse, power-profiles-daemon, upower, xdg-desktop-portal, xdg-desktop-portal-gtk, xdg-desktop-portal-wlr, zenity
Suggests: ddcutil, gdm3
Conflicts: denial-git
Homepage: https://github.com/denialwm/denial
Description: smooth customizable Wayland compositor with glass effects
 Wayland compositor, settings application and desktop portal backend built
 for Linux on aarch64."